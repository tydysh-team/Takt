# Copy this file to .env and replace the password before starting local services.
# Never commit the resulting .env file.
POSTGRES_DB=takt
POSTGRES_USER=takt
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+asyncpg://takt:replace-with-a-random-local-password@postgres:5432/takt
# Persistence/API tests must use a separate, migrated PostgreSQL database.
TEST_DATABASE_URL=postgresql+asyncpg://takt:replace-with-a-random-local-password@localhost:5432/takt_test

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
# Development also accepts the matching 127.0.0.1 origin on the same port.
# Required by browsers enforcing Local Network Access for localhost development.
# The Backend always disables this permission when APP_ENV=production.
CORS_ALLOW_PRIVATE_NETWORK=true
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
ENABLE_HSTS=false

# Generate independent values with a cryptographically secure password generator.
# These placeholders are intentionally rejected as production secrets.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
REFRESH_TOKEN_HMAC_KEY=replace-with-a-different-32-character-random-value
RATE_LIMIT_HMAC_KEY=replace-with-another-32-character-random-value
INVITATION_CODE_SECRET=replace-with-an-independent-32-character-random-value
ADMIN_SESSION_SECRET=replace-with-a-separate-32-character-random-value
JWT_ISSUER=takt-api
JWT_AUDIENCE=takt-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=7
LOGIN_RATE_LIMIT=5
REGISTER_RATE_LIMIT=3
INVITATION_ACCEPT_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
VITE_API_BASE_URL=http://localhost:8000

